# SYN flood: >=100 SYN packets from a single source within 10 seconds.
alert tcp any any -> any any (
    msg:"THREAT SYN Flood Detected";
    flags:S;
    flow:stateless;
    detection_filter:track by_src, count 100, seconds 10;
    classtype:attempted-dos;
    sid:1000001; rev:2;)

# Port scan: >=20 SYN packets (unique dst ports) from a single source
# within 60 seconds.
alert tcp any any -> $HOME_NET any (
    msg:"THREAT Possible Port Scan";
    flags:S;
    flow:stateless;
    detection_filter:track by_src, count 20, seconds 60;
    classtype:network-scan;
    sid:1000002; rev:2;)

# ICMP flood: >=200 echo requests from a single source within 10 seconds.
alert icmp any any -> $HOME_NET any (
    msg:"THREAT ICMP Flood Detected";
    itype:8;
    detection_filter:track by_src, count 200, seconds 10;
    classtype:attempted-dos;
    sid:1000003; rev:1;)

# UDP flood: >=200 UDP packets from a single source within 10 seconds.
alert udp any any -> $HOME_NET any (
    msg:"THREAT UDP Flood Detected";
    detection_filter:track by_src, count 200, seconds 10;
    classtype:attempted-dos;
    sid:1000004; rev:1;)

# Horizontal scan: many SYN probes to SSH port across the home network.
alert tcp any any -> $HOME_NET 22 (
    msg:"THREAT Possible Horizontal Scan";
    flags:S;
    flow:stateless;
    detection_filter:track by_src, count 30, seconds 60;
    classtype:network-scan;
    sid:1000005; rev:1;)

# ARP spoofing: repeated unsolicited ARP reply packets from one source.
alert arp any any -> any any (
    msg:"THREAT ARP Spoofing Suspected";
    arp_opcode:2;
    detection_filter:track by_src, count 20, seconds 30;
    classtype:attempted-recon;
    sid:1000006; rev:1;)

# MAC flooding pattern: heavy ARP request volume from a single source.
alert arp any any -> any any (
    msg:"THREAT Potential MAC Flooding";
    arp_opcode:1;
    detection_filter:track by_src, count 120, seconds 10;
    classtype:attempted-dos;
    sid:1000007; rev:1;)

# SSH brute-force pattern: repeated SSH connection attempts from one source.
alert tcp any any -> $HOME_NET 22 (
    msg:"THREAT SSH Brute Force Pattern";
    flags:S;
    flow:stateless;
    detection_filter:track by_src, count 40, seconds 60;
    classtype:attempted-admin;
    sid:1000008; rev:1;)